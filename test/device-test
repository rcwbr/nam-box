#!/bin/bash

set -e

docker buildx bake --allow=fs=/var/buildx-cache effects proxy web files $@

MDLH_ARGS="${MDLH_ARGS:-}$*"

./mender-docker-lifecycle-helper \
  --no-delta \
  --platform linux/arm64 \
  --manifest-name nam-box \
  --wait-for-deploy \
  --device-type raspberrypi5 \
  --device-group nam-box-test \
  --service-file proxy ./proxy.tar \
  --service-file web ./web.tar \
  --service-file effects ./effects.tar \
  --service-file model ./files.tar \
  --log-level DEBUG \
  --cache-limit-percent 20.0 \
  ${MDLH_ARGS} \
  manifests/docker-compose.yaml
