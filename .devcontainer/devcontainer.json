{
  "containerEnv": {
    "DEVCONTAINER_HOST_WORKSPACE_MOUNT": "/var/lib/docker/codespacemount/workspace/nam-box",
    "DOCKER_HOST": "unix:///var/run/docker.sock",
    "DOCKER_TLS_VERIFY": "0",
    "DOCKER_API_VERSION": "1.43"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.hcl",
        "ms-azuretools.vscode-docker",
        "bierner.markdown-mermaid",
        "joshbolduc.commitlint"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "image": "nam-box-devcontainer",
  "initializeCommand": ".devcontainer/initialize",
  "mounts": [
    {
      "source": "/var/run/docker.sock",
      "target": "/var/run/docker.sock",
      "type": "bind"
    }
  ],
  "name": "nam-box",
  "onCreateCommand": "/opt/devcontainers/on_create_command",
  "postStartCommand": "/opt/devcontainers/post_start_commands/hermes-webui"
}
