# ═══════════════════════════════════════════════════════════════════════════════
# Hermes WebUI — environment configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env in the same directory, then edit values as needed.
#   cp .env.example .env
#
# Docker Compose variable substitution: values can be referenced as ${VAR}.
# If a variable is unset, the default fallback after ":-" is used.

# ─── Host user UID / GID ─────────────────────────────────────────────────────
# Match these to your host user so bind-mounted files are readable.
# On Linux:  echo "WANTED_UID=$(id -u)" >> .env
#            echo "WANTED_GID=$(id -g)" >> .env
# On macOS:  UIDs start at 501, not 1000.
# On Codespaces: the default codespace user is UID 1000, so these can stay
# as-is unless you override the image user.
WANTED_UID=1000
WANTED_GID=1000

# ─── Docker socket group ─────────────────────────────────────────────────────
# GID of the `docker` group on the host, used at build time to let the container
# user talk to the Docker socket.
# Linux:   stat -c %g /var/run/docker.sock
# macOS:   (Docker Desktop socket — group is `staff`, GID 50)
# Codespaces: usually 800 (matches dockerfile-partials convention).
DOCKER_GID=800

# ─── Base image ──────────────────────────────────────────────────────────────
# The stock Hermes WebUI image to extend with the Docker CLI.
# Find available tags at: https://github.com/nesquena/hermes-webui/releases
# or via:  ghcr.io/nesquena/hermes-webui:0.52.166
WEBUI_BASE_IMAGE=ghcr.io/nesquena/hermes-webui:0.52.166

# Name of the local image produced by the build.
WEBUI_LOCAL_IMAGE=hermes-webui:local

# ─── WebUI port ──────────────────────────────────────────────────────────────
# The port the WebUI listens on *inside* the container.
# The host/Codespace port is WEBUI_HOST_PORT.
WEBUI_PORT=8787

# Host-side bind for port forwarding.
#   0.0.0.0:8787  → public (Codespaces: accessible from anywhere)   (default)
#   127.0.0.1:8787 → private (localhost only)
WEBUI_HOST_PORT=0.0.0.0:8787

# ─── WebUI password (optional) ───────────────────────────────────────────────
# If set, the WebUI requires this password to access.
# Generate a strong one:  openssl rand -hex 16
HERMES_WEBUI_PASSWORD=

# ─── Host paths ─────────────────────────────────────────────────────────────
# Where on the host the Hermes home directory and workspace are mounted.
# Defaults use $HOME so no changes are needed for standard installs.
# On macOS the home dir is /Users/<you>; on Linux /home/<you> or /root.


# ─── Container name ──────────────────────────────────────────────────────────
WEBUI_CONTAINER_NAME=hermes-webui

# ─── Permission handling (advanced) ─────────────────────────────────────────
# When mounting an EXISTING ~/.hermes directory, the WebUI's startup
# credential-permission fixer can clash with host file modes (e.g. 0640
# group-readable .env files).
#
# Skip the chmod fixer entirely:
# HERMES_SKIP_CHMOD=1
# OR allow group bits while stripping world-readable:
# HERMES_HOME_MODE=0640
